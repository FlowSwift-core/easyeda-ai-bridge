{
	"name": "extension",
	"version": "1.0.0",
	"description": "EasyEDA AI Bridge Extension",
	"author": "EasyEDA AI Team",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/wanghsinche/easy-eda-bridge.git",
		"directory": "apps/extension"
	},
	"bugs": {
		"url": "https://github.com/wanghsinche/easy-eda-bridge/issues"
	},
	"homepage": "https://github.com/wanghsinche/easy-eda-bridge#readme",
	"engines": {
		"node": ">=20.17.0"
	},
	"scripts": {
		"update-build-time": "ts-node ./build/update-build-time.ts",
		"prebuild": "cd ../eext-frontend && npm run build && cd ../extension && npx ts-node ./build/sync-version.ts",
		"precompile": "cp -r ./dist ./dist.bak",
		"compile": "ts-node ./config/esbuild.prod.ts",
		"postcompile": "cp -r ./dist.bak/iframe.js ./dist.bak/styles.css ./dist.bak/index.html ./dist/ 2>/dev/null || true && rm -rf ./dist.bak",
		"lint": "eslint",
		"fix": "eslint --fix",
		"build": "npm run compile && ts-node ./build/packaged.ts"
	},
  "bridgeUrl": "https://easyeda-ai-bridge.findata-be.uk",
  "dependencies": {
		"overlayscrollbars": "^2.14.0",
		"scroll-into-view-if-needed": "^3.1.0"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^5.4.1",
		"@jlceda/pro-api-types": "^0.2.21",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^22.15.30",
		"esbuild": "^0.24.2",
		"eslint": "^9.37.0",
		"fs-extra": "^11.3.0",
		"ignore": "^7.0.3",
		"jszip": "^3.10.1",
		"lint-staged": "^16.2.3",
		"rimraf": "^6.0.1",
		"sharp": "^0.34.5",
		"simple-git-hooks": "^2.13.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.3"
	}
}
